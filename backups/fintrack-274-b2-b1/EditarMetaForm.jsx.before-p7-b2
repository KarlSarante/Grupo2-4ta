import { useRef, useState } from "react";
import { z } from "zod";
import { actualizarObjetivo } from "../services/objetivoService.js";

const MAXIMO = 9999999999.99;

function convertirMonto(valor) {
  const texto = String(valor ?? "").trim();
  if (!/^\d+(?:\.\d{1,2})?$/.test(texto)) return NaN;
  return Number(texto);
}

function fechaValida(valor) {
  if (!/^\d{4}-\d{2}-\d{2}$/.test(valor)) return false;

  const [anio, mes, dia] = valor.split("-").map(Number);
  if (anio < 1 || mes < 1 || mes > 12 || dia < 1) return false;

  const fecha = new Date(0);
  fecha.setUTCHours(0, 0, 0, 0);
  fecha.setUTCFullYear(anio, mes - 1, dia);

  return (
    fecha.getUTCFullYear() === anio &&
    fecha.getUTCMonth() === mes - 1 &&
    fecha.getUTCDate() === dia
  );
}

function fechaInicial(valor) {
  if (!valor) return "";
  const texto = String(valor).slice(0, 10);
  return fechaValida(texto) ? texto : "";
}

const esquema = z.strictObject({
  nombre: z.string().trim()
    .min(2, "Escribe al menos 2 caracteres.")
    .max(100, "El nombre no puede superar 100 caracteres."),
  monto_objetivo: z.number()
    .finite("Introduce un monto objetivo válido.")
    .positive("El objetivo debe ser mayor que cero.")
    .max(MAXIMO, "El monto supera el máximo permitido.")
    .refine(
      (monto) =>
        Math.abs(monto * 100 - Math.round(monto * 100)) < 1e-6,
      "El monto no puede tener más de dos decimales."
    ),
  fecha_limite: z.string()
    .refine(fechaValida, "Introduce una fecha válida.")
    .nullable(),
});

export default function EditarMetaForm({
  meta,
  onCancelar,
  onActualizada,
  onEstadoGuardando,
}) {
  const [valores, setValores] = useState(() => ({
    nombre: String(meta.nombre ?? ""),
    monto_objetivo: String(meta.monto_objetivo ?? ""),
    fecha_limite: fechaInicial(meta.fecha_limite),
  }));

  const [errores, setErrores] = useState({});
  const [errorGeneral, setErrorGeneral] = useState("");
  const [guardando, setGuardando] = useState(false);
  const bloqueo = useRef(false);

  const acumulado = Number(meta.monto_actual ?? 0);
  const acumuladoTexto = Number.isFinite(acumulado)
    ? acumulado.toLocaleString("es-DO", {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      })
    : "No disponible";

  function cambiar(campo, valor) {
    if (bloqueo.current) return;

    setValores((anterior) => ({ ...anterior, [campo]: valor }));
    setErrores((anterior) => ({ ...anterior, [campo]: "" }));
    setErrorGeneral("");
  }

  async function guardar(evento) {
    evento.preventDefault();
    if (bloqueo.current) return;

    const objetivo = convertirMonto(valores.monto_objetivo);
    const fecha = valores.fecha_limite.trim();
    const nuevosErrores = {};

    if (!Number.isFinite(objetivo)) {
      nuevosErrores.monto_objetivo =
        "Introduce un monto válido con hasta dos decimales.";
    }

    if (fecha && !fechaValida(fecha)) {
      nuevosErrores.fecha_limite = "Introduce una fecha válida.";
    }

    const datos = {
      nombre: valores.nombre.trim(),
      monto_objetivo: objetivo,
      fecha_limite: fecha || null,
    };

    const validacion = esquema.safeParse(datos);

    if (!validacion.success) {
      for (const problema of validacion.error.issues) {
        const campo = problema.path[0];
        if (campo && !nuevosErrores[campo]) {
          nuevosErrores[campo] = problema.message;
        }
      }
    }

    if (Object.keys(nuevosErrores).length) {
      setErrores(nuevosErrores);
      return;
    }

    bloqueo.current = true;
    setGuardando(true);
    onEstadoGuardando(true);
    setErrorGeneral("");

    try {
      const respuesta = await actualizarObjetivo(
        meta.id,
        validacion.data
      );
      const actualizada = respuesta?.objetivo;

      if (
        !actualizada ||
        actualizada.id == null ||
        String(actualizada.id) !== String(meta.id)
      ) {
        throw new Error(
          "El servidor no confirmó correctamente la meta actualizada."
        );
      }

      onEstadoGuardando(false);
      onActualizada(actualizada);
    } catch (error) {
      setErrorGeneral(
        (error?.message || "No se pudo confirmar la actualización.") +
        " Consulta la meta antes de volver a intentarlo."
      );
      // No reenviar un PUT cuyo resultado pueda ser incierto.
      setGuardando(false);
      onEstadoGuardando(false);
    }
  }

  return (
    <form
      className="fintrack-nueva-meta-form"
      onSubmit={guardar}
      noValidate
    >
      <h2 id="fintrack-editar-meta-titulo">
        Editar meta financiera
      </h2>

      <div className="fintrack-nueva-meta-campo">
        <label htmlFor="editar-meta-nombre">
          Nombre de la meta *
        </label>
        <input
          id="editar-meta-nombre"
          name="nombre"
          autoFocus
          maxLength={100}
          value={valores.nombre}
          onChange={(evento) =>
            cambiar("nombre", evento.target.value)
          }
          disabled={guardando || bloqueo.current}
          aria-invalid={Boolean(errores.nombre)}
          aria-describedby={
            errores.nombre ? "editar-meta-nombre-error" : undefined
          }
        />
        {errores.nombre && (
          <p
            id="editar-meta-nombre-error"
            className="fintrack-nueva-meta-error"
            role="alert"
          >
            {errores.nombre}
          </p>
        )}
      </div>

      <div className="fintrack-nueva-meta-campo">
        <label htmlFor="editar-meta-objetivo">
          Monto objetivo (RD$) *
        </label>
        <input
          id="editar-meta-objetivo"
          name="monto_objetivo"
          type="text"
          inputMode="decimal"
          value={valores.monto_objetivo}
          onChange={(evento) =>
            cambiar("monto_objetivo", evento.target.value)
          }
          disabled={guardando || bloqueo.current}
          aria-invalid={Boolean(errores.monto_objetivo)}
          aria-describedby={
            errores.monto_objetivo
              ? "editar-meta-objetivo-error"
              : undefined
          }
        />
        {errores.monto_objetivo && (
          <p
            id="editar-meta-objetivo-error"
            className="fintrack-nueva-meta-error"
            role="alert"
          >
            {errores.monto_objetivo}
          </p>
        )}
      </div>

      <div className="fintrack-nueva-meta-campo">
        <label htmlFor="editar-meta-acumulado">
          Monto acumulado (RD$)
        </label>
        <input
          id="editar-meta-acumulado"
          type="text"
          value={acumuladoTexto}
          readOnly
          tabIndex={-1}
          aria-readonly="true"
        />
      </div>

      <div className="fintrack-nueva-meta-campo">
        <label htmlFor="editar-meta-fecha">
          Fecha límite (opcional)
        </label>
        <input
          id="editar-meta-fecha"
          name="fecha_limite"
          type="date"
          value={valores.fecha_limite}
          onChange={(evento) =>
            cambiar("fecha_limite", evento.target.value)
          }
          disabled={guardando || bloqueo.current}
          aria-invalid={Boolean(errores.fecha_limite)}
          aria-describedby={
            errores.fecha_limite
              ? "editar-meta-fecha-error"
              : undefined
          }
        />
        {errores.fecha_limite && (
          <p
            id="editar-meta-fecha-error"
            className="fintrack-nueva-meta-error"
            role="alert"
          >
            {errores.fecha_limite}
          </p>
        )}
      </div>

      <p className="fintrack-aportacion-aviso">
        Puedes establecer un objetivo inferior al monto acumulado.
        Las aportaciones se conservarán y el excedente seguirá
        registrado. Deja la fecha vacía para eliminar el límite.
      </p>

      {errorGeneral && (
        <p className="fintrack-nueva-meta-error" role="alert">
          {errorGeneral}
        </p>
      )}

      <div className="fintrack-nueva-meta-acciones">
        <button
          type="button"
          className="fintrack-nueva-meta-cancelar"
          onClick={onCancelar}
          disabled={guardando}
        >
          Cancelar
        </button>
        <button
          type="submit"
          className="fintrack-nueva-meta-guardar"
          disabled={guardando || bloqueo.current}
        >
          {guardando ? "Guardando..." : "Guardar cambios"}
        </button>
      </div>
    </form>
  );
}
